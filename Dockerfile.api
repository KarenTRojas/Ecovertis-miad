FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements_api.txt .
RUN pip install --no-cache-dir -r requirements_api.txt

COPY api_ecovertis.py modelos_entrega2.py ./
COPY modelos_guardados/ ./modelos_guardados/
COPY resultados/analisis_mensual_parques.csv ./resultados/analisis_mensual_parques.csv

RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8001
CMD ["uvicorn", "api_ecovertis:app", "--host", "0.0.0.0", "--port", "8001"]
